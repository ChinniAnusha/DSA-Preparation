class DSU:
    def __init__(self,n):
        self.rank = [0]*n
        self.parent = list(range(n))
        
    def find(self,x):
        if self.parent[x] != x:
          self.parent[x] = self.find(self.parent[x])
        return self.parent[x] 

    def union(self,u,v):
        ulp_u = self.find(u)
        ulp_v = self.find(v)
        if ulp_u == ulp_v:
            return
        if self.rank[ulp_u] < self.rank[ulp_v]:
            self.parent[ulp_v] = ulp_u
        elif self.rank[ulp_v] < self.rank[ulp_u]:
            self.parent[ulp_u] = ulp_v
        else:
            self.parent[ulp_u] = ulp_v
            self.rank[ulp_u] += 1

class Solution:
    def accountsMerge(self, accounts: List[List[str]]) -> List[List[str]]:
        n = len(accounts)
        dsu = DSU(n) 


        
        #union accounts having common emails
        mapMailnode = {}
        for i in range(n):
            for j in range(1,len(accounts[i])):
                mail = accounts[i][j]
                if mail not in mapMailnode:
                    mapMailnode[mail] = i
                else:
                    dsu.union(i,mapMailnode[mail])
       
        #Group Mails under ultimate parent
        merged_mail = [[] for _ in range(n)]
        for mail,idx in mapMailnode.items():
            node = dsu.find(idx)
            merged_mail[node].append(mail)

        #merged list
        ans = []
        for i in range(n):
            if not merged_mail[i]:
                continue
            
            merged_mail[i].sort()
            temp = [accounts[i][0]]
            
            for mail in merged_mail[i]:
                temp.append(mail)
            ans.append(temp)
        
        ans.sort()
        return ans
