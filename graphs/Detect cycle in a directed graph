def detectCycleInDirectedGraph(n, edges):
    adj = [[] for _ in range(n+1)]
    for u,v in edges:
        adj[u].append(v)

    visited = [0]*(n+1)
    path = [0]*(n+1)
    for i in range(1,n+1):
        if visited[i] == 0:
            if dfscheck(i,visited,path,adj):
                return True
    return False

def dfscheck(node,visited,path,adj):
    visited[node] = 1
    path[node] = 1
    for neigh in adj[node]:
        if visited[neigh] == 0:
            if dfscheck(neigh,visited,path,adj):
                return True
        elif path[neigh] == 1:
            return True
    path[node] = 0
    return False
