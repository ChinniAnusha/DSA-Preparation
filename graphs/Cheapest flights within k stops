class Solution:
    def findCheapestPrice(self, n: int, flights: List[List[int]], src: int, dst: int, k: int) -> int:
        dist = [float('inf')]*n
        dist[src] = 0
        for i in range(k+1):
             temp = dist.copy()
             for u,v,cost in flights:
                if dist[u] != float('inf') and dist[u] + cost < temp[v]:
                    temp[v] = dist[u] + cost
             dist = temp
            
        if dist[dst] != float('inf'):
            return dist[dst]
        
        return -1  
#TC:O(K*E)
#SC:O(n)
