from collections import deque
class Solution:
    def canFinish(self, numCourses: int, prerequisites: List[List[int]]) -> bool:
        adj = [[] for _ in range(numCourses)]
        indegree = [0]*numCourses

        for u,v in prerequisites:
            adj[v].append(u)
            indegree[u] += 1
        
        q = deque()
        for i in range(numCourses):
            if indegree[i] == 0:
                q.append(i)
        
        topo = []
        while q:
            node = q.popleft()
            topo.append(node)
            for nodess in adj[node]:
                indegree[nodess] -= 1
                if indegree[nodess] == 0:
                    q.append(nodess)
        if len(topo) == numCourses:
            return True
        return False

#TC:O(V+E)
