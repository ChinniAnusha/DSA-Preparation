import heapq
class Solution:
    def countPaths(self, n: int, roads: List[List[int]]) -> int:
        nways = [0]*n
        adj_list = [[] for _ in range(n)]
        for u,v,w in roads:
            adj_list[u].append((v,w))
            adj_list[v].append((u,w))
        dist = [float('inf')]*n
        pq = []
        heapq.heappush(pq,(0,0))
        dist[0] = 0
        nways[0] = 1
        while pq:
            distance,node = heapq.heappop(pq)

            for neigh,w in adj_list[node]:
                if distance+w < dist[neigh]:
                    dist[neigh] = distance+w
                    heapq.heappush(pq,(dist[neigh],neigh))
                    nways[neigh] = nways[node]

                elif distance+w == dist[neigh]:
                    nways[neigh] = (nways[neigh] + nways[node]) % (10**9 + 7)

        return nways[n-1]
